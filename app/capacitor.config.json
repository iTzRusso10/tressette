{
  "appId": "it.giusepperussodev.napoletane",
  "appName": "Napoletane",
  "webDir": "www",
  "backgroundColor": "#0B1226",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0B1226",
    "scrollEnabled": false
  },
  "android": {
    "backgroundColor": "#0B1226"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#0B1226",
      "showSpinner": false
    }
  }
}
