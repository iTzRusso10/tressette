# Online: copia questo file in .env e metti i dati del progetto Supabase
# (Supabase → Project Settings → API). La chiave "anon" è pubblica: va bene nell'app.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Video premio (AdMob): gli id delle unità "con premio". Senza, si vedono i video di prova di Google.
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
